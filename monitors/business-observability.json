          "thresholds": {
            "critical": 5
          },
          "require_full_window": false,
          "evaluation_delay": 60
        },
        "tags": [
          "team:stray-kitty",
          "service:kitty-api",
          "env:preview",
          "business-module:1",
          "managed-by:stray-kitty-biz-obs",
          "definition:battle-start-volume",
          "role:component"
        ]
      }
    },
    {
      "id": "battle-no-settlement",
      "payload": {
        "name": "[小猫回家记][业务-主线] [条件] 30 分钟战斗结算 < 1",
        "type": "query alert",
        "query": "sum(last_30m):sum:kitty.battle.settle{service:kitty-api,env:preview,!qa:true}.as_count() < 1",
        "message": "复合告警的条件子监控；无通知接收人，仅供组合状态求值。",
        "options": {
          "notify_no_data": false,
