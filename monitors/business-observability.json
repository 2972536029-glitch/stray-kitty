          "business-module:1",
          "managed-by:stray-kitty-biz-obs",
          "definition:battle-no-settlement",
          "role:component"
        ]
      }
    },
    {
      "id": "battle-stalled",
      "payload": {
        "name": "[小猫回家记][业务-主线] 战斗只有开始没有结算",
        "type": "composite",
        "query": "${battle-start-volume} && ${battle-no-settlement}",
        "message": "30 分钟开始次数 >= 5 且结算次数 < 1。先查 COMPLETE_BATTLE 的错误与重放状态。该窗口计数是链路故障信号，不是每场战斗的一对一配对。\n\n@slack-bj_xsolla_school-hans-team",
        "options": {
          "notify_no_data": false,
          "notify_audit": false,
          "renotify_interval": 0
        },
        "tags": [
          "team:stray-kitty",
          "service:kitty-api",
          "env:preview",
          "business-module:1",
          "managed-by:stray-kitty-biz-obs",
          "definition:battle-stalled",
          "role:alert"
        ]
      }
    },
    {
      "id": "battle-return-deviation",
      "payload": {
        "name": "[小猫回家记][业务-主线] 战后返回校验失败",
        "type": "query alert",
        "query": "sum(last_15m):sum:kitty.battle.return_check{service:kitty-api,env:preview,!qa:true,result:deviation}.as_count() >= 3",
        "message": "15 分钟内战后返回位置偏离达到 3 次。检查存档中的 map/returnPosition 与结算后位置；区域口径见模块一实现文档。\n\n@slack-bj_xsolla_school-hans-team",
        "options": {
          "notify_no_data": false,
          "notify_audit": false,
          "renotify_interval": 0,
          "thresholds": {
            "critical": 3
          },
          "require_full_window": false,
          "evaluation_delay": 60
        },
        "tags": [
          "team:stray-kitty",
          "service:kitty-api",
          "env:preview",
          "business-module:1",
          "managed-by:stray-kitty-biz-obs",
          "definition:battle-return-deviation",
          "role:alert"
        ]
      }
    },
    {
      "id": "payment-declined",
      "payload": {
        "name": "[小猫回家记][业务-经营] 支付拒付率过高(演示业务异常)",
        "type": "query alert",
        "query": "sum(last_15m):((sum:kitty.payment.charge{service:kitty-api,env:preview,!qa:true,result:declined}.as_count() / (sum:kitty.payment.charge{service:kitty-api,env:preview,!qa:true,result:declined}.as_count() + sum:kitty.payment.charge{service:kitty-api,env:preview,!qa:true,result:success}.as_count())) * 100) >= 50",
        "message": "15 分钟内超过一半的充值以 declined 结束(HTTP 全 200,属于「服务健康但业务异常」)。{{#is_alert}} 拒付是正常业务路径,但占比异常时先查演示卡使用方式(4242 成功/0000 拒付)与前端传参。{{/is_alert}} {{#is_recovery}} 拒付率已回落。{{/is_recovery}} 无支付流量时显示 No Data 属预期。\n\n@slack-bj_xsolla_school-hans-team\n原有告警原地接管，保留 50% 阈值；增加 preview/QA 过滤并修正 as_count 的时间聚合。无流量分母为零时不视为异常。",
        "options": {
          "notify_no_data": false,
          "notify_audit": false,
          "renotify_interval": 0,
          "thresholds": {
            "critical": 50
          },
          "require_full_window": false,
          "evaluation_delay": 120
        },
        "tags": [
          "team:stray-kitty",
          "service:kitty-api",
          "env:preview",
          "business-module:3",
          "managed-by:stray-kitty-biz-obs",
          "definition:payment-declined",
          "role:alert",
          "purpose:payment-business",
          "owner:biz-module3"
        ]
      },
      "adopt_names": [
        "[小猫回家记] 支付拒付率过高(演示业务异常)"
      ]
    },
    {
      "id": "advisor-fallback",
      "payload": {
        "name": "[小猫回家记][业务-经营] 阿策降级率过高",
        "type": "query alert",
        "query": "sum(last_15m):((sum:kitty.advisor.call{service:kitty-api,env:preview,!qa:true,result:fallback}.as_count() / sum:kitty.advisor.call{service:kitty-api,env:preview,!qa:true}.as_count()) * 100) >= 50",
        "message": "15 分钟内超过一半的阿策问答走了本地兜底(未用到模型)。{{#is_alert}} 按 reason tag 细分:not_configured=环境缺 key(配置问题)、provider_rate_limited=配额打满、timeout/provider_unavailable=服务不可达、invalid_response=返回不合规范。{{/is_alert}} {{#is_recovery}} 降级率已回落。{{/is_recovery}}\n\n@slack-bj_xsolla_school-hans-team\n原有告警原地接管，保留 50% 阈值；增加 preview/QA 过滤并修正 as_count 的时间聚合。无流量分母为零时不视为异常。",
        "options": {
          "notify_no_data": false,
