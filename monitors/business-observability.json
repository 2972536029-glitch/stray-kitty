  "dashboards": [
    {
      "id": "story-dashboard",
      "payload": {
        "title": "[小猫回家记][业务-主线] 主线漏斗与玩法",
        "description": "#18 业务观测 · preview · [managed-by:stray-kitty-biz-obs;definition:story-dashboard]\n由 monitors/business-observability.json 维护；变更需同步代码。",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "note",
              "content": "主线各阶段采用当前窗口事件次数，不是去重玩家漏斗或留存率；同一玩家重复开始可能多次计数。全部查询固定 env:preview，并排除 qa:true。历史未打 qa 标签的数据仍包含。胜率仅 win/(win+lose)，retreat/unknown 单列；零分母显示无数据。",
              "background_color": "white",
              "font_size": "14",
              "text_align": "left",
              "has_padding": true
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "主线阶段触达次数（按章入口节点）",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "session",
                      "query": "sum:kitty.session.started{service:kitty-api,env:preview,!qa:true}.as_count()",
                      "aggregator": "sum"
                    },
                    {
                      "data_source": "metrics",
                      "name": "prologue",
                      "query": "sum:kitty.story.node{service:kitty-api,env:preview,!qa:true,node:prologue_1}.as_count()",
                      "aggregator": "sum"
                    },
                    {
                      "data_source": "metrics",
                      "name": "alley",
                      "query": "sum:kitty.story.node{service:kitty-api,env:preview,!qa:true,node:chapter1_intro}.as_count()",
                      "aggregator": "sum"
                    },
                    {
                      "data_source": "metrics",
                      "name": "market",
                      "query": "sum:kitty.story.node{service:kitty-api,env:preview,!qa:true,node:market_intro_1}.as_count()",
                      "aggregator": "sum"
                    },
                    {
                      "data_source": "metrics",
                      "name": "greenhouse",
                      "query": "sum:kitty.story.node{service:kitty-api,env:preview,!qa:true,node:greenhouse_intro_1}.as_count()",
                      "aggregator": "sum"
                    },
                    {
                      "data_source": "metrics",
                      "name": "rescue",
                      "query": "sum:kitty.story.node{service:kitty-api,env:preview,!qa:true,node:rescue_intro_1}.as_count()",
                      "aggregator": "sum"
                    },
                    {
                      "data_source": "metrics",
                      "name": "finale",
                      "query": "sum:kitty.story.node{service:kitty-api,env:preview,!qa:true,node:finale_intro_1}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "session"
                    },
                    {
                      "formula": "prologue"
                    },
                    {
                      "formula": "alley"
                    },
                    {
                      "formula": "market"
                    },
                    {
                      "formula": "greenhouse"
                    },
                    {
                      "formula": "rescue"
                    },
                    {
                      "formula": "finale"
                    }
                  ],
                  "response_format": "timeseries",
                  "display_type": "line"
                }
              ]
