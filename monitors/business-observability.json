  "monitors": [
    {
      "id": "story-session-volume",
      "payload": {
        "name": "[小猫回家记][业务-主线] [条件] 30 分钟开局量 > 5",
        "type": "query alert",
        "query": "sum(last_30m):sum:kitty.session.started{service:kitty-api,env:preview,!qa:true}.as_count() > 5",
        "message": "复合告警的条件子监控；无通知接收人，仅供组合状态求值。",
        "options": {
          "notify_no_data": false,
          "notify_audit": false,
          "renotify_interval": 0,
          "thresholds": {
            "critical": 5
          },
          "require_full_window": false,
          "evaluation_delay": 60
        },
        "tags": [
          "team:stray-kitty",
          "service:kitty-api",
          "env:preview",
          "business-module:1",
          "managed-by:stray-kitty-biz-obs",
          "definition:story-session-volume",
          "role:component"
        ]
      }
    },
    {
      "id": "story-no-progress",
      "payload": {
        "name": "[小猫回家记][业务-主线] [条件] 30 分钟剧情推进 < 1",
        "type": "query alert",
        "query": "sum(last_30m):sum:kitty.story.node{service:kitty-api,env:preview,!qa:true,!node:prologue_1}.as_count() < 1",
        "message": "复合告警的条件子监控；无通知接收人，仅供组合状态求值。",
        "options": {
          "notify_no_data": false,
          "notify_audit": false,
          "renotify_interval": 0,
          "thresholds": {
            "critical": 1
          },
          "require_full_window": false,
          "evaluation_delay": 60
        },
        "tags": [
          "team:stray-kitty",
          "service:kitty-api",
          "env:preview",
          "business-module:1",
          "managed-by:stray-kitty-biz-obs",
          "definition:story-no-progress",
          "role:component"
        ]
      }
    },
    {
      "id": "story-stalled",
      "payload": {
        "name": "[小猫回家记][业务-主线] 剧情节点断流",
        "type": "composite",
        "query": "${story-session-volume} && ${story-no-progress}",
        "message": "30 分钟开局次数 > 5 且后续剧情推进次数 < 1（排除新建会话必发的 prologue_1）。仅 preview、排除 qa:true。检查 START_STORY / ADVANCE_STORY 的拒绝与持久化日志；复合条件子监控无独立通知。\n\n@slack-bj_xsolla_school-hans-team",
        "options": {
          "notify_no_data": false,
          "notify_audit": false,
          "renotify_interval": 0
        },
        "tags": [
          "team:stray-kitty",
          "service:kitty-api",
          "env:preview",
          "business-module:1",
          "managed-by:stray-kitty-biz-obs",
          "definition:story-stalled",
          "role:alert"
        ]
      }
    },
    {
      "id": "battle-start-volume",
      "payload": {
        "name": "[小猫回家记][业务-主线] [条件] 30 分钟战斗开始 >= 5",
        "type": "query alert",
        "query": "sum(last_30m):sum:kitty.battle.start{service:kitty-api,env:preview,!qa:true}.as_count() >= 5",
        "message": "复合告警的条件子监控；无通知接收人，仅供组合状态求值。",
        "options": {
          "notify_no_data": false,
          "notify_audit": false,
