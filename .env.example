GAME_ADDR=127.0.0.1:8017
GAME_DATA_FILE=../data/game.json
GAME_WEB_DIR=../web/dist

# Server environment only. Never use a VITE_ prefix or commit a real key.
# Export these to the Go process; this example file is not loaded automatically.
ADVISOR_BASE_URL=https://api.deepseek.com
ADVISOR_MODEL=deepseek-flash
ADVISOR_API_KEY=

# ---- Xsolla sandbox payment (paymentd) ----
# Set the first three to switch paymentd from mock (4242/0000 demo cards)
# to the Xsolla sandbox provider (PayStation redirect + webhook delivery).
# Values come from Publisher Account; get them from your teacher/team lead.
# Never commit real credentials: keep them in deploy secrets or a local .env.
XSOLLA_MERCHANT_ID=
XSOLLA_PROJECT_ID=
XSOLLA_API_KEY=
# Webhook signature key from Publisher Account > Project settings > Webhooks.
XSOLLA_WEBHOOK_SECRET=
# 团队阶段铁律:所有环境只允许沙盒。true = 无真实扣款。
# paymentd 启动时强制校验:XSOLLA_SANDBOX=false 会直接拒绝启动(代码级闸门)。
# 移除此闸需要正式签署发行协议并经团队评审,不得私自修改。
XSOLLA_SANDBOX=true
# Where PayStation redirects the player after payment (frontend origin + ?payment=return).
# Example: http://localhost:8017/?payment=return — set it to your public preview URL.
XSOLLA_RETURN_URL=
# Cluster-internal callback so the webhook can credit tuna into the game save.
# paymentd -> game API; INTERNAL_TOKEN must match on both services.
GAME_INTERNAL_URL=
INTERNAL_TOKEN=
