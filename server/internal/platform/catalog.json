  "story": [
    {
      "id": "prologue_1",
      "chapterId": "prologue",
      "speaker": "喵喵",
      "text": "呼噜噜……午后的阳光晒在毛毯上真舒服。那个天蓝色的小饭碗擦得干干净净，两脚兽今天上菜还算勤快。",
      "next": "prologue_home_narrator",
      "exit": "",
      "scene": "home"
    },
    {
      "id": "prologue_home_narrator",
      "chapterId": "prologue",
      "speaker": "旁白",
      "text": "微风轻轻拂动窗帘，阳台的纱门留着一条细细的缝隙。风里忽然飘来一缕极特殊的香气——焦香酥脆、鲜美浓郁。",
      "next": "prologue_scent",
      "exit": "",
      "scene": "home"
    },
    {
      "id": "prologue_scent",
      "chapterId": "prologue",
      "speaker": "喵喵",
      "text": "等一下——鼻尖突然动了！这绝不是普通的干粮，是金枪鱼！而且是刚煎出焦边的新鲜金枪鱼！就在楼下街角……",
      "next": "prologue_sneak",
      "exit": "",
      "scene": "home"
    },
    {
      "id": "prologue_sneak",
      "chapterId": "prologue",
      "speaker": "喵喵",
      "text": "咕噜噜……本咪的小肚子突然有了强烈的想法。本咪只是身为领地之王，顺便下楼巡视两分钟。只尝一口，一口就回来，肯定不会迷路！",
      "next": "prologue_street",
      "exit": "",
      "scene": "home"
    },
    {
      "id": "prologue_street",
      "chapterId": "prologue",
      "speaker": "旁白",
      "text": "喵喵一溜烟钻出了门。可是外面的街道远比客厅宽阔喧闹，刺耳的车鸣、飞驰的卡车，还有从未踩过的粗糙泥沙，让习惯了毛毯的小爪子有些不知所措。",
      "next": "prologue_thunder",
      "exit": "",
      "scene": "alley"
    },
    {
      "id": "prologue_thunder",
      "chapterId": "prologue",
      "speaker": "旁白",
      "text": "还没等找到香味的源头，天色猛地阴沉下来。一声惊雷在铁皮屋檐上炸响，紧接着是冰冷湍急的倾盆大雨。",
      "next": "prologue_rain",
      "exit": "",
      "scene": "alley"
    },
    {
      "id": "prologue_rain",
      "chapterId": "prologue",
      "speaker": "旁白",
      "text": "雨把熟悉的气味冲淡了。蓝色饭碗不见了，暖毯也不见了，只有陌生小巷在灯下闪着水光。",
      "next": "prologue_lost",
      "exit": "",
      "scene": "alley"
    },
    {
      "id": "prologue_lost",
      "chapterId": "prologue",
      "speaker": "喵喵",
      "text": "哇啊！泥巴全溅到肚皮上了……咪才没有害怕。咪只是……暂时不知道家在哪边。",
      "next": "prologue_tuanzi",
      "exit": "",
      "scene": "alley"
    },
    {
      "id": "prologue_tuanzi",
      "chapterId": "alley",
      "speaker": "团子",
      "text": "哟，哪来的小少爷？圆滚滚、一身奶香味，爪子都踩成泥巴球了，脖子上的小铃铛还在晃呢。",
      "next": "prologue_banter",
      "exit": "",
      "scene": "alley"
    },
    {
      "id": "prologue_banter",
      "chapterId": "alley",
      "speaker": "喵喵",
      "text": "谁是小少爷！本咪是微服私访的领地巡察官！……咕噜噜（肚子大声抗议）……本咪只是出来视察民情！",
      "next": "prologue_2",
      "exit": "",
      "scene": "alley"
    },
    {
      "id": "prologue_2",
      "chapterId": "alley",
      "speaker": "团子",
      "text": "行行行，大巡察官。不过先别逞强了——听，那边垃圾桶后的破纸箱里，好像有只猫需要帮忙。",
      "next": "",
      "exit": "explore",
      "scene": "alley"
    },
    {
      "id": "rescue_1",
      "chapterId": "alley",
      "speaker": "点点",
      "text": "呜……谢谢你们！要是没有你们，我早就被那些冰冷的黑影抓走了……小巷深处最近经常有暗影游荡，已经有好几个伙伴无声无息地失踪了。",
      "next": "poster_1",
      "exit": "",
      "scene": "alley"
    },
    {
      "id": "poster_1",
      "chapterId": "alley",
      "speaker": "喵喵",
      "text": "墙上这只猫……怎么和咪一模一样？还有这个名字。原来，家里也一直在找咪。",
      "next": "poster_warmth",
      "exit": "",
      "scene": "poster",
      "setFlags": [
        "lost_poster_found"
      ]
    },
    {
      "id": "poster_warmth",
      "chapterId": "alley",
      "speaker": "喵喵",
      "text": "海报上印着咪最宝贝的天蓝色饭碗，还有两脚兽焦急写下的字迹……原来两脚兽没有把咪忘掉，他们真的好着急。",
      "next": "poster_2",
      "exit": "",
      "scene": "poster"
    },
    {
      "id": "poster_2",
      "chapterId": "alley",
      "speaker": "点点",
      "text": "你已经找到回家的线索了。现在就走，也来得及。别像我们一样在街头挨饿受冻……",
      "next": "poster_hesitate",
      "exit": "",
      "scene": "poster"
    },
    {
      "id": "poster_hesitate",
      "chapterId": "alley",
      "speaker": "团子",
      "text": "团子也叹了口气：“点点说得对。街头的黑影越来越危险，日子不好过。趁天还没全黑，顺着熟悉的气味回你的暖毯上去吧。”",
      "next": "poster_3",
      "exit": "",
      "scene": "poster"
    },
    {
      "id": "poster_3",
      "chapterId": "alley",
      "speaker": "喵喵",
      "text": "……先把失踪的猫找回来。回家的路不会跑掉，但它们现在需要咪。",
      "next": "poster_resolve",
      "exit": "",
      "scene": "poster"
    },
    {
      "id": "poster_resolve",
      "chapterId": "alley",
      "speaker": "喵喵",
      "text": "本咪可是微服私访的领地巡察官！哪有巡察官丢下受难伙伴自己跑路的道理！听好了，先把所有失踪的猫咪都救出来，本咪再光荣回家！",
      "next": "rescue_tuanzi_admire",
      "exit": "",
      "scene": "poster"
    },
    {
      "id": "rescue_tuanzi_admire",
      "chapterId": "alley",
      "speaker": "团子",
      "text": "团子咧嘴笑了：“好样的小少爷！真有骨气！既然要干票大的，就不能让点点再窝在破纸箱里受寒。”",
      "next": "rescue_greenhouse_proposal",
      "exit": "",
      "scene": "poster"
    },
    {
      "id": "rescue_greenhouse_proposal",
      "chapterId": "alley",
      "speaker": "团子",
      "text": "老街转角有一座被遗忘的废弃花房。虽然漏雨破旧，但骨架结实，只要咱们一起收拾，就能变成谁也闯不进来的根据地！",
      "next": "rescue_2",
      "exit": "",
      "scene": "alley"
    },
    {
      "id": "rescue_2",
      "chapterId": "greenhouse",
      "speaker": "喵喵",
      "text": "那就先把这座旧花房收拾一下吧。一只猫的纸箱，也可以变成大家的家。",
      "next": "",
      "exit": "home",
      "scene": "home"
    },
    {
      "id": "event_forced_chase",
      "chapterId": "alley",
      "speaker": "团子",
      "text": "这条路暂时走不通！喵喵陪着点点，我去前面的灯下引路。先撤到有光的地方，再守住她的出口。",
      "next": "",
      "exit": "preparation",
      "scene": "alley",
      "setFlags": [
        "withdrawal_route_reached"
      ]
    },
    {
      "id": "event_detour",
      "chapterId": "alley",
      "speaker": "点点",
      "text": "原来的出口被积水挡住了……沿着这边的墙走吧。谢谢你愿意等我，我们一起到路灯下重新准备。",
      "next": "",
      "exit": "preparation",
      "scene": "alley",
      "setFlags": [
        "detour_completed"
      ]
    },
    {
      "id": "market_intro_1",
      "chapterId": "market",
      "speaker": "团子",
      "text": "穿过这条下水道铁栅栏就是了——欢迎来到【午夜集市】！整座城市里流浪的猫咪和各路飞鸟都在这里互通有无。",
      "next": "market_intro_2",
      "exit": "",
      "scene": "market"
    },
    {
      "id": "market_intro_2",
      "chapterId": "market",
      "speaker": "旁白",
      "text": "微光闪烁的暖黄色灯泡挂在生锈水管上，空气中弥漫着烤鱼骨的烟气与瓶盖叮当的脆响。木箱之间穿梭着各色流浪猫，神情警惕却又自得其乐。",
      "next": "market_intro_3",
      "exit": "",
      "scene": "market"
    },
    {
      "id": "market_intro_3",
      "chapterId": "market",
      "speaker": "喵喵",
      "text": "哇……这里居然藏着这么大的地下集市！原来在两脚兽看不见的地方，流浪猫也有属于自己的热闹世界！",
      "next": "market_intro_4",
      "exit": "",
      "scene": "market"
    },
    {
      "id": "market_intro_4",
      "chapterId": "market",
      "speaker": "团子",
      "text": "别光顾着看稀奇。看见前面挂着单片镜的乌鸦老黑羽、还有吹牛的灰鸽子了吗？去打听失踪猫咪的消息，还有常在暗道独行的神秘黑猫墨墨！",
      "next": "",
      "exit": "explore",
      "scene": "market",
      "setFlags": [
        "market_unlocked",
        "chapter_2_started"
      ]
    }
  ],
