{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "stray-kitty-preview-data",
        "namespace": "cn-haozhe-wang",
        "labels": {"app.kubernetes.io/name": "stray-kitty", "app.kubernetes.io/instance": "haozhe-preview"}
      },
      "spec": {
        "accessModes": ["ReadWriteOnce"],
        "resources": {"requests": {"storage": "1Gi"}}
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "stray-kitty-preview",
        "namespace": "cn-haozhe-wang",
        "labels": {"app.kubernetes.io/name": "stray-kitty", "app.kubernetes.io/instance": "haozhe-preview"}
      },
      "spec": {
        "replicas": 1,
        "strategy": {"type": "Recreate"},
        "revisionHistoryLimit": 3,
        "selector": {"matchLabels": {"app.kubernetes.io/name": "stray-kitty", "app.kubernetes.io/instance": "haozhe-preview"}},
        "template": {
          "metadata": {
            "labels": {"app.kubernetes.io/name": "stray-kitty", "app.kubernetes.io/instance": "haozhe-preview"}
          },
          "spec": {
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 30,
            "imagePullSecrets": [{"name": "stray-kitty-preview-registry"}],
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001,
              "fsGroupChangePolicy": "OnRootMismatch",
              "seccompProfile": {"type": "RuntimeDefault"}
            },
            "containers": [
              {
                "name": "game",
                "image": "RELEASE_IMAGE_NOT_SELECTED",
                "imagePullPolicy": "IfNotPresent",
                "ports": [{"name": "http", "containerPort": 8080, "protocol": "TCP"}],
                "env": [
                  {"name": "GAME_ADDR", "value": "0.0.0.0:8080"},
                  {"name": "GAME_DATA_FILE", "value": "/data/game.json"},
                  {"name": "GAME_WEB_DIR", "value": "/app/web"},
                  {"name": "ADVISOR_BASE_URL", "value": "https://api.deepseek.com"},
                  {"name": "ADVISOR_MODEL", "value": "deepseek-flash"},
                  {"name": "ADVISOR_API_KEY", "valueFrom": {"secretKeyRef": {"name": "stray-kitty-preview-advisor", "key": "api-key", "optional": true}}},
                  {"name": "ADVISOR_MAX_CONCURRENT", "value": "4"},
                  {"name": "ADVISOR_DAILY_REQUEST_LIMIT", "value": "200"}
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {"drop": ["ALL"]}
                },
                "resources": {
                  "requests": {"cpu": "100m", "memory": "128Mi"},
                  "limits": {"cpu": "1", "memory": "512Mi"}
                },
                "startupProbe": {"httpGet": {"path": "/healthz", "port": "http"}, "periodSeconds": 2, "failureThreshold": 30},
                "readinessProbe": {"httpGet": {"path": "/readyz", "port": "http"}, "periodSeconds": 5, "timeoutSeconds": 2},
                "livenessProbe": {"httpGet": {"path": "/healthz", "port": "http"}, "periodSeconds": 10, "timeoutSeconds": 2},
                "volumeMounts": [{"name": "progress", "mountPath": "/data"}, {"name": "tmp", "mountPath": "/tmp"}]
              }
            ],
            "volumes": [
              {"name": "progress", "persistentVolumeClaim": {"claimName": "stray-kitty-preview-data"}},
              {"name": "tmp", "emptyDir": {"medium": "Memory", "sizeLimit": "16Mi"}}
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "stray-kitty-preview",
        "namespace": "cn-haozhe-wang",
        "labels": {"app.kubernetes.io/name": "stray-kitty", "app.kubernetes.io/instance": "haozhe-preview"}
      },
      "spec": {
        "type": "LoadBalancer",
        "externalTrafficPolicy": "Cluster",
        "selector": {"app.kubernetes.io/name": "stray-kitty", "app.kubernetes.io/instance": "haozhe-preview"},
        "ports": [{"name": "http", "protocol": "TCP", "port": 80, "targetPort": "http"}]
      }
    }
  ]
}
