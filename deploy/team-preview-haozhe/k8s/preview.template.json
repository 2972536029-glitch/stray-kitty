    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "stray-kitty-frontend",
        "namespace": "cn-haozhe-wang",
        "labels": {
          "app.kubernetes.io/name": "stray-kitty",
          "app.kubernetes.io/instance": "haozhe-preview",
          "app.kubernetes.io/component": "frontend"
        }
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "revisionHistoryLimit": 3,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "stray-kitty",
            "app.kubernetes.io/instance": "haozhe-preview",
            "app.kubernetes.io/component": "frontend"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "stray-kitty",
              "app.kubernetes.io/instance": "haozhe-preview",
              "app.kubernetes.io/component": "frontend"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 30,
            "shareProcessNamespace": true,
            "imagePullSecrets": [
              {
                "name": "stray-kitty-preview-registry"
              }
            ],
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 101,
              "runAsGroup": 101,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "frontend",
                "image": "RELEASE_IMAGE_NOT_SELECTED",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080,
                    "protocol": "TCP"
                  },
                  {
                    "name": "https",
                    "containerPort": 8443,
                    "protocol": "TCP"
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 2
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 2
                },
                "volumeMounts": [
                  {
                    "name": "nginx-cache",
                    "mountPath": "/var/cache/nginx"
                  },
                  {
                    "name": "nginx-run",
                    "mountPath": "/var/run"
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "tls",
                    "mountPath": "/certs",
                    "readOnly": true,
                    "subPath": "certs"
                  }
                ]
              },
              {
                "name": "certbot",
                "image": "neilpang/acme.sh:3.1.0",
                "imagePullPolicy": "IfNotPresent",
                "env": [
                  {
                    "name": "DuckDNS_Token",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "stray-kitty-preview-duckdns",
                        "key": "token",
                        "optional": true
                      }
                    }
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "runAsNonRoot": false,
                  "runAsUser": 0,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ],
                    "add": [
                      "KILL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "10m",
                    "memory": "16Mi"
                  },
                  "limits": {
                    "cpu": "200m",
                    "memory": "64Mi"
                  }
                },
                "command": [
                  "sh",
                  "-c",
                  "set -eu\nmkdir -p /acme /certs\nif [ ! -f /certs/fullchain.pem ] || [ ! -f /certs/privkey.pem ]; then\n  openssl req -x509 -newkey rsa:2048 -nodes -keyout /certs/privkey.pem -out /certs/fullchain.pem -days 1 -subj '/CN=placeholder' 2>/dev/null\n  chmod 644 /certs/fullchain.pem /certs/privkey.pem\nfi\nif [ -z \"${DuckDNS_Token:-}\" ]; then\n  echo 'DuckDNS token absent; TLS placeholder stays, staying HTTP-only.'\n  while :; do sleep 3600; done\nfi\nacme.sh --config-home /acme --set-default-ca --server letsencrypt\n# DuckDNS shares one TXT value across subdomains. Authorize www first so only\n# the apex needs a DNS challenge when ordering the combined certificate.\nacme.sh --config-home /acme --issue --dns dns_duckdns -d www.starry-kitty.duckdns.org --keylength ec-256 || [ \"$?\" -eq 2 ]\nacme.sh --config-home /acme --issue --dns dns_duckdns -d starry-kitty.duckdns.org -d www.starry-kitty.duckdns.org --keylength ec-256 || [ \"$?\" -eq 2 ]\nacme.sh --config-home /acme --install-cert -d starry-kitty.duckdns.org --ecc --fullchain-file /certs/fullchain.pem --key-file /certs/privkey.pem --reloadcmd 'chmod 644 /certs/fullchain.pem /certs/privkey.pem; pgrep -o nginx | xargs -r kill -HUP'\nwhile :; do\n  sleep 12h\n  acme.sh --config-home /acme --renew -d www.starry-kitty.duckdns.org --ecc || true\n  acme.sh --config-home /acme --renew -d starry-kitty.duckdns.org --ecc || true\ndone"
                ],
                "volumeMounts": [
                  {
                    "name": "tls",
                    "mountPath": "/certs",
                    "subPath": "certs"
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  },
                  {
                    "name": "acme",
                    "mountPath": "/acme",
                    "subPath": "acme"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "nginx-cache",
                "emptyDir": {}
              },
              {
                "name": "nginx-run",
                "emptyDir": {}
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "medium": "Memory",
                  "sizeLimit": "16Mi"
                }
              },
              {
                "name": "tls",
                "persistentVolumeClaim": {
                  "claimName": "stray-kitty-tls-state"
                }
              },
              {
                "name": "acme",
                "persistentVolumeClaim": {
                  "claimName": "stray-kitty-tls-state"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "stray-kitty-preview",
        "namespace": "cn-haozhe-wang",
        "labels": {
          "app.kubernetes.io/name": "stray-kitty",
          "app.kubernetes.io/instance": "haozhe-preview",
          "app.kubernetes.io/component": "frontend"
        }
      },
      "spec": {
        "type": "LoadBalancer",
        "externalTrafficPolicy": "Cluster",
        "selector": {
          "app.kubernetes.io/name": "stray-kitty",
          "app.kubernetes.io/instance": "haozhe-preview",
          "app.kubernetes.io/component": "frontend"
        },
        "ports": [
          {
            "name": "http",
            "protocol": "TCP",
            "port": 80,
            "targetPort": "http"
          },
          {
            "name": "https",
            "protocol": "TCP",
            "port": 443,
            "targetPort": "https"
          }
        ]
      }
    }
  ]
}
