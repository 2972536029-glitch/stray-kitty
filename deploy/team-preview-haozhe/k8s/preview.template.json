                "volumeMounts": [
                  {
                    "name": "progress",
                    "mountPath": "/data"
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "progress",
                "persistentVolumeClaim": {
                  "claimName": "stray-kitty-preview-data"
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "medium": "Memory",
                  "sizeLimit": "16Mi"
                }
              }
            ]
          }
        }
