# 游戏服务镜像:仅 Go API(目录 go:embed 内嵌),静态文件由独立前端容器托管。
# 构建上下文:仓库根目录。
FROM golang:1.26-alpine AS api
WORKDIR /app/server
# server 合入 Datadog SDK 后构建需拉外部模块;默认 proxy.golang.org 在受限网络不可达,与 .gitlab-ci.yml 的 server job 保持一致
ENV GOPROXY=https://goproxy.cn,direct
COPY server ./
RUN CGO_ENABLED=0 go build -trimpath -o /kitty-api ./cmd/api

FROM alpine:3.23
ARG BUILD_REVISION=unverified
LABEL org.opencontainers.image.revision="${BUILD_REVISION}"
RUN apk add --no-cache ca-certificates \
    && update-ca-certificates \
    && addgroup -S -g 10001 kitty \
    && adduser -S -u 10001 kitty -G kitty \
    && mkdir /data \
    && chown 10001:10001 /data
WORKDIR /app
COPY --from=api /kitty-api /app/kitty-api
USER 10001:10001
ENV GAME_ADDR=0.0.0.0:8080 \
    GAME_DATA_FILE=/data/game.json \
    GAME_WEB_DIR=disabled
EXPOSE 8080
ENTRYPOINT ["/app/kitty-api"]
