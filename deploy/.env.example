# Datadog 可观测性配置(deploy/compose.yaml 的 --profile observability 需要)
# 复制为 .env 并填入真实值;.env 已被 .gitignore 忽略,严禁提交。
DD_API_KEY=
DD_SITE=us5.datadoghq.com
DD_ENV=dev
DD_VERSION=0.1.0
DD_TEAM=stray-kitty

# Optional MySQL profile. Generate non-empty password files first (DATABASE.md).
# Paths are relative to deploy/compose.yaml; do not commit these files.
MYSQL_PASSWORD_FILE=./private/mysql-password
MYSQL_ROOT_PASSWORD_FILE=./private/mysql-root-password
# Empty = existing JSON mode. For database mode set the dedicated application DSN:
# stray_kitty:<password-file-content>@tcp(mysql:3306)/stray_kitty?parseTime=true
GAME_MYSQL_DSN=
