    {
      "id": "prologue",
      "title": "序章 · 金枪鱼事件",
      "summary": "喵喵追着香味走失，寻找回家的路。",
      "status": "demo"
    },
    {
      "id": "alley",
      "title": "第一章 · 陌生小巷",
      "summary": "认识团子，救助点点，发现寻猫启事。",
      "status": "demo"
    },
    {
      "id": "market",
      "title": "第二章 · 午夜集市",
      "summary": "交换线索，认识不同猫咪的生活，发现花房。",
      "status": "planned"
    },
    {
      "id": "greenhouse",
      "title": "第三章 · 废弃花房",
      "summary": "伙伴们共同整理花房，建立庇护所。",
      "status": "planned"
    },
    {
      "id": "rescue",
      "title": "第四章 · 消失的猫咪们",
      "summary": "侦查暗道与仓库，逐步救回失踪伙伴。",
      "status": "planned"
    },
    {
      "id": "finale",
      "title": "终章 · 点亮流浪猫王国",
      "summary": "用光源护送伙伴撤离，喵喵与主人团聚并继续看望伙伴。",
      "status": "planned"
    }
  ],
  "story": [
    {
      "id": "prologue_1",
      "chapterId": "prologue",
      "speaker": "喵喵",
      "text": "等一下——这股香味……是金枪鱼！只追一下下，肯定不会迷路的。",
      "next": "prologue_rain",
      "exit": ""
    },
    {
      "id": "prologue_2",
      "chapterId": "alley",
      "speaker": "团子",
      "text": "喂，新来的！先别急着找家。那边的纸箱里，好像有只猫需要帮忙。",
      "next": "",
      "exit": "explore"
    },
    {
      "id": "rescue_1",
      "chapterId": "alley",
      "speaker": "点点",
      "text": "谢谢你们……我叫点点。原来，我们也可以一起找到安全的地方。",
      "next": "poster_1",
      "exit": ""
    },
    {
      "id": "rescue_2",
      "chapterId": "greenhouse",
      "speaker": "喵喵",
      "text": "那就先把这座旧花房收拾一下吧。一只猫的纸箱，也可以变成大家的家。",
      "next": "",
      "exit": "home",
      "scene": "home"
    },
    {
      "id": "prologue_rain",
      "chapterId": "prologue",
      "speaker": "旁白",
      "text": "雨把熟悉的气味冲淡了。蓝色饭碗不见了，暖毯也不见了，只有陌生小巷在灯下闪着水光。",
      "next": "prologue_lost",
      "exit": "",
      "scene": "alley"
    },
    {
      "id": "prologue_lost",
      "chapterId": "prologue",
      "speaker": "喵喵",
      "text": "咪才没有害怕。咪只是……暂时不知道家在哪边。",
      "next": "prologue_2",
      "exit": "",
      "scene": "alley"
    },
    {
      "id": "poster_1",
      "chapterId": "alley",
      "speaker": "喵喵",
      "text": "墙上这只猫……怎么和咪一模一样？还有这个名字。原来，家里也一直在找咪。",
      "next": "poster_2",
      "exit": "",
      "scene": "poster",
      "setFlags": [
        "lost_poster_found"
      ]
    },
    {
      "id": "poster_2",
      "chapterId": "alley",
      "speaker": "点点",
      "text": "你已经找到回家的线索了。现在就走，也来得及。",
      "next": "poster_3",
      "exit": "",
      "scene": "poster"
    },
    {
      "id": "poster_3",
      "chapterId": "alley",
      "speaker": "喵喵",
      "text": "……先把失踪的猫找回来。回家的路不会跑掉，但它们现在需要咪。",
      "next": "rescue_2",
      "exit": "",
      "scene": "poster"
    },
    {
      "id": "event_forced_chase",
      "chapterId": "alley",
      "speaker": "团子",
      "text": "这条路暂时走不通！喵喵陪着点点，我去前面的灯下引路。先撤到有光的地方，再守住她的出口。",
      "next": "",
      "exit": "preparation",
      "scene": "alley",
      "setFlags": [
        "withdrawal_route_reached"
      ]
    },
    {
      "id": "event_detour",
      "chapterId": "alley",
      "speaker": "点点",
      "text": "原来的出口被积水挡住了……沿着这边的墙走吧。谢谢你愿意等我，我们一起到路灯下重新准备。",
      "next": "",
      "exit": "preparation",
      "scene": "alley",
      "setFlags": [
        "detour_completed"
      ]
    }
  ],
