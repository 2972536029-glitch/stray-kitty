      "options": [
        {
          "id": "search",
          "label": "仔细搜索周围的物资",
          "outcomes": {
            "crit": {
              "text": "你找到了一盏明亮的小灯和新的爪印，点点愿意相信你。撤离路线变得更安全了。",
