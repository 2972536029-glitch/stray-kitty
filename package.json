{
  "name": "stray-kitty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "content:sync": "node scripts/content.mjs",
    "content:check": "node scripts/content.mjs --check",
    "typecheck": "npm run typecheck --workspace web",
    "test": "tsx --test tests/core.test.ts tests/content.test.ts tests/l00-integration.test.ts tests/rainy-alley-map.test.ts tests/home-story.test.ts tests/home-modular.test.ts tests/home-editor.test.ts tests/home-life.test.ts tests/qa-flow.test.ts tests/session-recovery.test.ts tests/market-interaction-target.test.ts tests/battle/*.test.ts",
    "test:server": "go -C server test ./...",
    "test:e2e": "playwright test",
    "test:player-flow": "node scripts/verify-player-flow.mjs",
    "api:check": "node scripts/check-api.mjs",
    "check": "node scripts/check.mjs",
    "build": "npm run content:check && npm run build --workspace web",
    "test:startup": "node scripts/smoke-dev.mjs",
    "architecture:build": "node scripts/architecture.mjs",
    "architecture:check": "node scripts/architecture.mjs --check"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "ajv": "8.20.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
